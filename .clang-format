---
Language: Cpp
BasedOnStyle: LLVM

# 重新分组：clang-format 会按 Priority 分组，组间自动加空行。
# 用 Preserve 的话只会组内排序，pch.h 不会“跳到最前”。
IncludeBlocks: Regroup

# 大小写敏感，避免 "Pch.h" 被误判
SortIncludes: CaseSensitive

IncludeCategories:
  # --- 1) 预编译头永远第一 ---------------------------------
  - Regex: '^"pch\.h"$'
    Priority: -1
    SortPriority: -1

  # --- 2) 项目内头文件（"..."）----------------------------
  - Regex: '^".*"$'
    Priority: 1
    SortPriority: 1

  # --- 3) 系统头文件（<...>）-----------------------------
  - Regex: "^<.*>$"
    Priority: 2
    SortPriority: 2

  # --- 4) 兜底 -------------------------------------------
  - Regex: ".*"
    Priority: 3
    SortPriority: 3
