{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "compiler-msvc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": {
          "type": "FILEPATH",
          "value": "$env{VCToolsInstallDir}bin/Hostx64/x64/cl.exe"
        },
        "CMAKE_AR": {
          "type": "FILEPATH",
          "value": "$env{VCToolsInstallDir}bin/Hostx64/x64/lib.exe"
        },
        "CMAKE_RANLIB": {
          "type": "FILEPATH",
          "value": "$env{VCToolsInstallDir}bin/Hostx64/x64/lib.exe"
        },
        "CMAKE_LINKER": {
          "type": "FILEPATH",
          "value": "$env{VCToolsInstallDir}bin/Hostx64/x64/link.exe"
        }
      }
    },
    {
      "name": "compiler-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER_FRONTEND_VARIANT": "MSVC"
      }
    },
    {
      "name": "type-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "type-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": ["base", "compiler-msvc", "type-debug"]
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "inherits": ["base", "compiler-msvc", "type-release"]
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": ["base", "compiler-clang", "type-debug"]
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": ["base", "compiler-clang", "type-release"]
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    }
  ]
}
