// cmake/Plugin.h.in

#pragma once

#include <REL/Relocation.h>
#include <string_view>

namespace Plugin {
using namespace std::literals;

inline constexpr REL::Version kVersion {
  // clang-format off
  @PROJECT_VERSION_MAJOR@u,
  @PROJECT_VERSION_MINOR@u,
  @PROJECT_VERSION_PATCH@u,
  // clang-format on
};

inline constexpr auto kName = "@PROJECT_NAME@"sv;
inline constexpr auto kAuthor = "@PROJECT_AUTHOR@"sv;
} // namespace Plugin
